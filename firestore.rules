rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Tem acesso à app = tem perfil em users/{uid} (criado pelo master em Utilizadores).
    function temPerfil() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Dois níveis de acesso:
    //  - Master (users/{uid}.master == true): faz tudo — criar, alterar, substituir,
    //    anexar, mover, eliminar, gerir utilizadores, logs e salários;
    //  - Utilizador (perfil sem master): só vê e descarrega.
    function isMaster() {
      return temPerfil() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.master == true;
    }

    function isAdmin() {
      return isMaster();
    }

    function isEditor() {
      return isMaster();
    }

    // Contabilidade e salários: só masters com acesso (acesso_contab/{uid}).
    function temContab() {
      return isMaster() && exists(/databases/$(database)/documents/acesso_contab/$(request.auth.uid));
    }

    // Marca da versão das regras: a app lê regras/v4 para confirmar que estas
    // regras estão publicadas (se a leitura for recusada, avisa o master).
    match /regras/{versao} {
      allow read: if temPerfil() && versao == 'v4';
      allow write: if false;
    }

    // Quem pode entrar na Contabilidade. A 1.ª pessoa a ativar a proteção fica
    // como dona (cria o seu acesso e o marcador _inicial na mesma operação);
    // depois, só quem já tem acesso pode dar ou retirar acesso a outros masters.
    match /acesso_contab/{id} {
      allow read: if temPerfil();
      allow create, delete: if temContab() && id != '_inicial';
      allow create: if isMaster()
        && (id == request.auth.uid || id == '_inicial')
        && !exists(/databases/$(database)/documents/acesso_contab/_inicial)
        && existsAfter(/databases/$(database)/documents/acesso_contab/_inicial)
        && existsAfter(/databases/$(database)/documents/acesso_contab/$(request.auth.uid));
      allow update: if false;
    }

    match /funcionarios/{docId} {
      allow read: if temPerfil();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /funcionarios/{funcionarioId}/documentos/{docId} {
      allow read: if temPerfil();
      allow create: if isEditor();
      // renomear ficheiros e mover entre subpastas (nome e pasta)
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // Recibos de vencimento (histórico mensal por trabalhador)
    // Dados salariais — só quem tem acesso à Contabilidade.
    match /funcionarios/{funcionarioId}/recibos/{reciboId} {
      allow read, create, update, delete: if temContab();
    }

    // Faltas e baixas médicas por trabalhador
    match /funcionarios/{funcionarioId}/faltas/{faltaId} {
      allow read: if temPerfil();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // Parâmetros fiscais/salariais (documento único editável)
    match /config/{docId} {
      allow read: if temPerfil();
      allow create, update: if isEditor();
      allow delete: if false;
    }

    // Histórico de alterações à configuração (imutável)
    match /config_history/{logId} {
      allow read: if temPerfil();
      allow create: if isEditor();
      allow update, delete: if false;
    }

    // Apuramento de IVA por trimestre
    match /iva/{trimestreId} {
      allow read, create, update, delete: if temContab();
    }

    // Faturas de despesas da empresa (por mês)
    match /despesas/{docId} {
      allow read, create, update, delete: if temContab();
    }

    // Documentos da empresa (separador Empresa): pastas, fichas e ficheiros
    match /empresa_itens/{itemId} {
      allow read: if temPerfil();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // Folha mensal para a contabilidade (editável manualmente)
    match /contabilidade/{mes} {
      allow read, create, update, delete: if temContab();
    }

    match /users/{userId} {
      // Cada utilizador pode ler o SEU próprio perfil (necessário para o login
      // determinar o role); só o master vê a lista completa e faz alterações.
      allow read: if isMaster() || (isAuth() && request.auth.uid == userId);
      allow write: if isMaster();
    }

    match /audit_logs/{logId} {
      allow read: if isMaster();
      allow create: if temPerfil();
      allow update, delete: if false;
    }
  }
}
