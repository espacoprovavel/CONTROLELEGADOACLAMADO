{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "tests/**",
      "*.md",
      "package.json",
      "package-lock.json"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
